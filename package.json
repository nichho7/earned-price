{
  "name": "earned-price",
  "version": "0.1.0",
  "description": "Earned Price: testnet escrow that pays agents only when a TEE grade passes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "earned": "cli/earned.js"
  },
  "files": [
    "cli/",
    "grader/",
    "packs/",
    "seller/",
    "verify/",
    "!packs/results/",
    "names.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "dev": "next dev",
    "build": "node scripts/site-rules.mjs && node scripts/site-data-gate.mjs && next build && node scripts/site-size-gate.mjs",
    "start": "next start",
    "site:typecheck": "tsc --noEmit",
    "site:unit": "node --test \"site/**/*.test.ts\"",
    "site:e2e": "playwright test",
    "site:ci": "npm run site:typecheck && npm run site:unit && npm run build && npm run site:e2e"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3"
  }
}
